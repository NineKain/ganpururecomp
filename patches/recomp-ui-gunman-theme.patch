diff --git a/src/common/launcher_theme.h b/src/common/launcher_theme.h
index 87d2cfd..5de54cf 100644
--- a/src/common/launcher_theme.h
+++ b/src/common/launcher_theme.h
@@ -303,7 +303,39 @@ static inline LauncherTheme launcher_theme_cdi(void) {
     return t;
 }
 
+// "Gunman's Proof" theme. Matches the in-game pixel menu: the same 16-colour
+// navy/gold palette, square corners, a pixel font, and CRT scanlines. Gold is
+// the one bold accent (primary action), sky blue marks headings.
+static inline LauncherTheme launcher_theme_gunman(void) {
+    LauncherTheme t = launcher_theme_default();
+    t.background      = lng_rgba(0.051f, 0.055f, 0.094f, 1.0f); // #0D0E18
+    t.background2     = lng_rgba(0.102f, 0.110f, 0.173f, 1.0f); // #1A1C2C
+    t.panel           = lng_rgba(0.102f, 0.110f, 0.173f, 1.0f); // #1A1C2C
+    t.panel_hovered   = lng_rgba(0.200f, 0.235f, 0.341f, 1.0f); // #333C57
+    t.control         = lng_rgba(0.200f, 0.235f, 0.341f, 1.0f); // #333C57
+    t.control_hovered = lng_rgba(0.271f, 0.322f, 0.478f, 1.0f); // #45527A
+    t.border          = lng_rgba(0.337f, 0.424f, 0.525f, 1.0f); // #566C86
+    t.accent          = lng_rgba(1.000f, 0.804f, 0.459f, 1.0f); // #FFCD75 gold
+    t.accent_dim      = lng_rgba(0.937f, 0.490f, 0.341f, 1.0f); // #EF7D57 orange
+    t.accent_text     = lng_rgba(0.102f, 0.110f, 0.173f, 1.0f); // dark ink on gold
+    t.accent2         = lng_rgba(0.255f, 0.651f, 0.965f, 1.0f); // #41A6F6 sky blue
+    t.text            = lng_rgba(0.957f, 0.957f, 0.957f, 1.0f); // #F4F4F4
+    t.text_muted      = lng_rgba(0.580f, 0.690f, 0.761f, 1.0f); // #94B0C2
+    t.good            = lng_rgba(0.655f, 0.941f, 0.439f, 1.0f); // #A7F070
+    t.warn            = lng_rgba(1.000f, 0.804f, 0.459f, 1.0f); // #FFCD75
+    t.focus_ring      = lng_rgba(1.000f, 0.804f, 0.459f, 1.0f); // gold
+    t.radius_sm = 0.0f; t.radius_lg = 0.0f;                     // square pixels
+    t.row_height = 40.0f;
+    t.font_body = 16.0f; t.font_title = 32.0f; t.font_small = 16.0f;
+    t.focus_ring_width = 2.0f;
+    t.scanlines = 1;
+    return t;
+}
+
 static inline LauncherTheme launcher_theme_by_name(const char* name) {
+    if (name && (name[0]=='g' || name[0]=='G') && (name[1]=='u' || name[1]=='U') &&
+        (name[2]=='n' || name[2]=='N'))
+        return launcher_theme_gunman();
     if (name && (name[0]=='c' || name[0]=='C') &&
         (name[1]=='d' || name[1]=='D') && (name[2]=='i' || name[2]=='I') && !name[3])
         return launcher_theme_cdi();
